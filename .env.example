# ================================================
#  DORA-AGENT — Konfigurasi Environment
#  Salin file ini menjadi .env lalu isi nilainya
#  Berlaku di Windows, Linux, dan macOS
# ================================================

# ── API Keys ──────────────────────────────────────
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ISI_API_KEY_GEMINI_DISINI

# Dapatkan di: https://openrouter.ai/keys
OPENROUTER_API_KEY=ISI_API_KEY_OPENROUTER_DISINI

# Dapatkan di: https://console.groq.com/keys  (Gratis, untuk transkripsi voice)
# Kosongkan jika ingin pakai Local Whisper saja
GROQ_API_KEY=ISI_API_KEY_GROQ_DISINI

# ── Mode AI ───────────────────────────────────────
# Pilihan: both | gemini_only | openrouter_only
AI_MODE=both

# ── Pengaturan Bot ────────────────────────────────
# true = hanya balas pesan pribadi (abaikan grup)
PRIVATE_ONLY=false

# Prefix perintah, kosongkan jika tidak perlu
# Contoh: BOT_PREFIX=! → bot hanya merespon pesan yang diawali !
BOT_PREFIX=

# ── Resource Management ───────────────────────────
VOICE_TRANSCRIBE_CONCURRENCY=2

# ── Dashboard Admin ────────────────────────────────
# Port untuk dashboard web admin (default: 3000)
DASHBOARD_PORT=3000

# Masukkan kode lisensi DORA Agent Anda di sini
# (Data ini sekarang disimpan secara aman di data/.dora_license.json)


