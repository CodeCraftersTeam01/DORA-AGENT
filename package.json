{
  "name": "dora-agent",
  "version": "1.0.0",
  "description": "WhatsApp AI Chatbot powered by Gemini & OpenRouter",
  "main": "index.js",
  "bin": "dist/index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build": "node scripts/build.js",
    "release": "npm run build && pkg . --output release/dora-agent.exe",
    "start:prod": "node dist/index.js",
    "deploy:prod": "node scripts/deploy-prod.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "ai",
    "gemini"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "lru-cache": "^11.3.5",
    "multer": "^2.1.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "fs-extra": "^11.3.4",
    "javascript-obfuscator": "^5.4.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "dist/dashboard/**/*",
      "dist/.env.example"
    ],
    "targets": [
      "node18-win-x64"
    ]
  }
}
